{
  "name": "moxy",
  "version": "1.3.5",
  "description": "Chrome extension for full response mocking — including status codes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:icons": "node scripts/generate-icons.mjs",
    "build:schema": "node scripts/compile-schema.mjs",
    "build": "bun run build:icons && bun run build:schema && vite build",
    "build:patch": "esbuild src/inject/patch.ts --bundle --format=iife --target=es2022 --outfile=dist/patch.js --legal-comments=none",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "bun run build:schema && vitest run",
    "test:coverage": "bun run build:schema && vitest run --coverage"
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.41.9",
    "picomatch": "^4.0.4",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@preact/preset-vite": "^2.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.0.268",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^25",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2"
  }
}
