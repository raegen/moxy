{
  "manifest_version": 3,
  "name": "moxy",
  "version": "1.1.3",
  "description": "Capture real responses, mutate status / body / latency, replay. No yellow banner.",
  "permissions": ["scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/inject/bridge.ts"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/sw.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "devtools_page": "src/devtools/devtools.html",
  "action": {
    "default_icon": "hello_extensions.png",
    "default_title": "moxy"
  },
  "icons": {
    "16": "hello_extensions.png",
    "48": "hello_extensions.png",
    "128": "hello_extensions.png"
  }
}
