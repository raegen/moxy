// Type declaration for the precompiled ajv standalone validator. The .mjs file
// is generated by scripts/compile-schema.mjs and committed; this .d.mts hand-
// written type lets TypeScript see its shape.

type AjvError = {
  instancePath: string;
  schemaPath: string;
  keyword: string;
  params: Record<string, unknown>;
  message?: string;
};

interface ValidateFn {
  (data: unknown): boolean;
  errors?: AjvError[] | null;
}

declare const validate: ValidateFn;
export default validate;
